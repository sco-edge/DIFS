# Author: KB 
# Date: 2026-05-29
# Purpose: for working with "worker_pool.txt" to properly create docker immage instead of doing it directly in that file (as was done previously)
# How to use it: run "docker build -f src/Dockerfile.diffusion -t difs-diffusion-worker ." to create difs-diffusion-worker which is then used in worker_pool.py

FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /workspace

# Copy the ENTIRE project
COPY . /workspace

RUN pip install --no-cache-dir -r requirements.txt

RUN pip install \
    protobuf==6.31.1 \
    grpcio==1.74.0 \
    grpcio-tools==1.74.0 \
    diffusers==0.39.0 \
    transformers==5.14.1 \
    accelerate==1.14.0 \
    safetensors==0.8.0 \
    huggingface-hub==1.24.0 \
    omegaconf==2.3.0 \
    scipy \
    pillow \
    torchmetrics

CMD ["bash"]