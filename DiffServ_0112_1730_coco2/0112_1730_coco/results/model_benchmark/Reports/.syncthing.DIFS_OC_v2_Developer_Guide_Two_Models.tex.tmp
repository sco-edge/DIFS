%======================================================================

\begin{longtable}{p{2cm} p{4.5cm} p{2cm} p{4.5cm}}
\toprule
\textbf{Port} & \textbf{Component} & \textbf{Protocol} & \textbf{Direction} \\
\midrule
\endfirsthead
\toprule
\textbf{Port} & \textbf{Component} & \textbf{Protocol} & \textbf{Direction} \\
\midrule
\endhead
50050 & Scheduler & gRPC & Client $\to$ Scheduler \\
50060 & Worker (default) & gRPC & Scheduler $\to$ Worker \\
50061+ & Additional workers & gRPC & Scheduler $\to$ Worker \\
\bottomrule
\end{longtable}

%======================================================================
\chapter{Quick Reference Card}
%======================================================================

\section{Start Everything}

\begin{lstlisting}[caption={Manual startup}]
# Terminal 1: Worker (SD 2.1)
python src/1/pytorch_container_diffusion_v3.py \
    -model 3 -sampler 1 -thread 10 -port 50060 \
    -npz /tmp/model/real_stats.npz

# Terminal 2: Server
python src/server.py

# Terminal 3: Client
python src/client_async_v3.py \
    -prompt_count 50 -steps 10 -sampler 1 -port 50050
\end{lstlisting}

\section{Run Two-Model Benchmark}

\begin{lstlisting}[caption={Two-model benchmark}]
PYTHONUNBUFFERED=1 python -m src.experiments.run_model_benchmark \
  --models 3 7 \
  --modes horizontal vertical hybrid \
  --workload 5 --steps 10
\end{lstlisting}

\section{Generate Two-Model Plots}

\begin{lstlisting}[caption={Plot generation}]
python src/plots/generate_two_model_plots.py
\end{lstlisting}

% ============================================================
% Glossary
% ============================================================
\newpage
\appendix
\chapter{Glossary of Terms}

\begin{table}[H]
\centering
\small
\begin{tabularx}{\linewidth}{>{\raggedright\arraybackslash}p{4.5cm} X}
\toprule
\textbf{Term} & \textbf{Definition} \\
\midrule
\texttt{--models 3 7} & Model IDs for the two-model benchmark. 3=SD-v1.5, 7=DreamShaper-8 (or 4=SD-2.1, 8=SD-3.5-Medium for the generational comparison). \\
\texttt{--modes horizontal vertical hybrid} & Scaling modes tested for each model. \\
\texttt{generate\_two\_model\_plots.py} & Script that filters the full benchmark data for two specific models and generates focused comparison plots. \\
\texttt{two\_models\_plot\_data/} & Filtered CSV subset containing only the two selected models' data. \\
\texttt{two\_models\_plots/} & Output directory for two-model-specific PNG plots. \\
\texttt{SD-2.1} & Stable Diffusion 2.1. UNet-based, 865M params, up to 768$\times$768 resolution. \\
\texttt{SD-3.5-Medium} & Stable Diffusion 3.5 Medium. MM-DiT transformer, 2.5B params, three text encoders. \\
\texttt{worker\_metrics.csv} & Per-request metrics: inference time, GPU memory usage, FID score. \\
\texttt{switch\_metrics.csv} & Model switching time recorded during LoadModel RPC calls. \\
\texttt{benchmark\_summary.csv} & One row per run: model, mode, avg\_latency, switch\_time. \\
\bottomrule
\end{tabularx}
\end{table}

